# InsureAssist configuration template.
# Copy to .env and edit. NEVER commit .env. Values below are safe placeholders only.
# Settings are introduced per milestone; unused settings are ignored until then.

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data

# --- Database (M5) -----------------------------------------------------------
POSTGRES_USER=insureassist
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=insureassist
DATABASE_URL=postgresql+psycopg://insureassist:change-me-local-only@localhost:5433/insureassist

# --- Authentication (M5) -----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-value-of-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=insureassist-api
JWT_AUDIENCE=insureassist-clients
JWT_ACCESS_TOKEN_TTL_MINUTES=15

# --- Input limits ------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500
MAX_JSON_BODY_KB=64
MAX_QUESTION_CHARS=2000
INGEST_TIMEOUT_SECONDS=120

# --- Rate limits (M5) --------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=10
CORS_ALLOWED_ORIGINS=http://localhost:8501

# --- Ingestion / chunking (M1) -----------------------------------------------
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120
CHUNK_MIN_CHARS=50
SCANNED_PAGE_MIN_CHARS=25

# --- Embeddings and retrieval (M2) -------------------------------------------
# Vector database: "faiss" (files in data/index, no server) or "qdrant" (server).
# Qdrant: docker compose up -d qdrant  ->  dashboard at http://localhost:6333/dashboard
VECTOR_STORE=faiss
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=insureassist_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_MODE=semantic
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=5
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_SEMANTIC_SCORE=0.25
INDEX_AUTO_REBUILD=false

# --- Reranking (M4, off until evaluation justifies it) -----------------------
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATES=20
RERANKER_MIN_SCORE=0.0

# --- LLM generation (M3) -----------------------------------------------------
# "gemini" (API, needs GEMINI_API_KEY) or "huggingface" (local open model, no key, no quota)
LLM_PROVIDER=gemini
HF_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_DTYPE=bfloat16
HF_MAX_NEW_TOKENS=384
# Leave empty to run with the fake provider / mocked tests only.
GEMINI_API_KEY=
# Example value; the current model name is verified at M3.
GEMINI_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Privacy -----------------------------------------------------------------
# When false, only a SHA-256 hash and length of each question are stored.
STORE_QUERY_TEXT=false

# --- UI (M5) -----------------------------------------------------------------
API_BASE_URL=http://localhost:8010
